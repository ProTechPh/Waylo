<?xml version="1.0" encoding="utf-8"?>
<!-- The same list as backup_rules.xml (Android 12 and later read this file; keep the two in step). -->
<data-extraction-rules>
    <cloud-backup>
        <include domain="sharedpref" path="waylo_settings.xml" />
        <include domain="sharedpref" path="waylo_onboarding.xml" />
        <include domain="sharedpref" path="waylo_notices.xml" />
        <include domain="sharedpref" path="waylo_units.xml" />
        <include domain="sharedpref" path="waylo_shortcuts.xml" />
        <include domain="sharedpref" path="waylo_saved.xml" />
        <include domain="sharedpref" path="waylo_saved_routes.xml" />
        <include domain="sharedpref" path="waylo_lists.xml" />
        <include domain="sharedpref" path="waylo_recents.xml" />
        <include domain="sharedpref" path="waylo_recent_places.xml" />
        <include domain="file" path="trips/" />
        <include domain="file" path="fonts/ui.ttf" />
    </cloud-backup>
    <device-transfer>
        <include domain="sharedpref" path="waylo_settings.xml" />
        <include domain="sharedpref" path="waylo_onboarding.xml" />
        <include domain="sharedpref" path="waylo_notices.xml" />
        <include domain="sharedpref" path="waylo_units.xml" />
        <include domain="sharedpref" path="waylo_shortcuts.xml" />
        <include domain="sharedpref" path="waylo_saved.xml" />
        <include domain="sharedpref" path="waylo_saved_routes.xml" />
        <include domain="sharedpref" path="waylo_lists.xml" />
        <include domain="sharedpref" path="waylo_recents.xml" />
        <include domain="sharedpref" path="waylo_recent_places.xml" />
        <include domain="file" path="trips/" />
        <include domain="file" path="fonts/ui.ttf" />
    </device-transfer>
</data-extraction-rules>
